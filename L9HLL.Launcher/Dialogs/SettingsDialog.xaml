<Window x:Class="L9HLL.Launcher.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="420" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI"
WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#1a1a1a" CornerRadius="8" BorderBrush="#444" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="#111" BorderBrush="#333" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Settings" FontSize="13" FontWeight="SemiBold"
                               Foreground="#8a9a5b" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="X" Width="24" Height="20" FontSize="10"
                            Background="Transparent" Foreground="#aaa" BorderBrush="Transparent"
                            Cursor="Hand" Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,16">
                <StackPanel>
                    <TextBlock Text="General" FontSize="12" FontWeight="SemiBold"
                               Foreground="#8a9a5b" Margin="0,0,0,8"/>
                    <Border Background="#2a2a2a" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Start on Windows Startup" FontSize="12" Margin="0,0,0,4"/>
                                <CheckBox x:Name="StartupCheckBox" Margin="0,4,0,0"
                                          Checked="OnStartupChecked" Unchecked="OnStartupUnchecked"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Start minimized to system tray" FontSize="12" Margin="0,0,0,4"/>
                                <CheckBox x:Name="MinimizedCheckBox" Margin="0,4,0,0"
                                          Checked="OnMinimizedChecked" Unchecked="OnMinimizedUnchecked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Auto-Launch" FontSize="12" FontWeight="SemiBold"
                               Foreground="#8a9a5b" Margin="0,0,0,8"/>
                    <Border Background="#2a2a2a" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Scheduled Time" FontSize="12" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AutoLaunchTimeText" FontSize="13"
                                               Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="ChangeTimeBtn" Content="Change" Width="70" Height="28"
                                            Background="#8a9a5b" Foreground="White" BorderBrush="#8a9a5b"
                                            Cursor="Hand" FontSize="11" Click="ChangeTimeBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Updates" FontSize="12" FontWeight="SemiBold"
                               Foreground="#8a9a5b" Margin="0,0,0,8"/>
                    <Border Background="#2a2a2a" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Check for updates automatically" FontSize="12" Margin="0,0,0,4"/>
                                <CheckBox x:Name="UpdatesCheckBox" Margin="0,4,0,0"
                                          Checked="OnUpdatesChecked" Unchecked="OnUpdatesUnchecked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckNowBtn" Content="Check Now" Width="90" Height="30"
                                        Background="#8a9a5b" Foreground="White" BorderBrush="#8a9a5b"
                                        Cursor="Hand" FontSize="11" Click="CheckNowBtn_Click"/>
                                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="11"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="About" FontSize="12" FontWeight="SemiBold"
                               Foreground="#8a9a5b" Margin="0,0,0,8"/>
                    <Border Background="#2a2a2a" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="#aaa" Margin="0,0,0,4"/>
                            <TextBlock Text="[L9] The Loyal Nine - HLL Launcher" FontSize="11" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>