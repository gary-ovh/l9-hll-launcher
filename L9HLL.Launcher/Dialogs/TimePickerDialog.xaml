<Window x:Class="L9HLL.Launcher.Dialogs.TimePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Auto-Launch Time"
        Height="340" Width="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Time" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="HourList" Grid.Column="0" Background="#2a2a2a" BorderBrush="#444"
                     Foreground="#e0e0e0" SelectionMode="Single">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>

            <TextBlock Grid.Column="1" Text=":" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="8,0"/>

            <ListBox x:Name="MinuteList" Grid.Column="2" Background="#2a2a2a" BorderBrush="#444"
                     Foreground="#e0e0e0" SelectionMode="Single">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="SelectedTimeText"
                   Text="--:--" FontSize="14" Foreground="#8a9a5b"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0"
                    Background="#333" Foreground="#aaa" BorderBrush="#444"
                    Cursor="Hand" Click="CancelBtn_Click"/>
            <Button Content="OK" Width="80" Height="30"
                    Background="#8a9a5b" Foreground="White" BorderBrush="#8a9a5b"
                    Cursor="Hand" Click="OkBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>