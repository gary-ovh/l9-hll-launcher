<Window x:Class="L9HLL.Launcher.Dialogs.TeamCalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Team Join"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Team Join Calibration" FontSize="14" FontWeight="SemiBold"
                   Foreground="#8a9a5b" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" x:Name="StepText" Text="" FontSize="12"
                   Foreground="White" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>

        <Border Grid.Row="2" x:Name="ScreenshotBorder" Background="#2a2a2a"
                BorderBrush="#444" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="ShotCanvas">
                <Image x:Name="ScreenshotImage" Stretch="None"
                       MouseLeftButtonDown="ScreenshotImage_MouseLeftButtonDown"/>
                <Line x:Name="AxisMarker" Stroke="#ffd27f" StrokeThickness="2" Visibility="Collapsed"/>
                <Ellipse x:Name="AxisDot" Width="12" Height="12" Stroke="#ffd27f" StrokeThickness="2"
                         Fill="#66ffd27f" Visibility="Collapsed"/>
                <Line x:Name="AlliesMarker" Stroke="#7fb8ff" StrokeThickness="2" Visibility="Collapsed"/>
                <Ellipse x:Name="AlliesDot" Width="12" Height="12" Stroke="#7fb8ff" StrokeThickness="2"
                         Fill="#667fb8ff" Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="ReadyBtn" Content="I'm Ready" Width="120" Height="32"
                    Background="#8a9a5b" Foreground="White" BorderBrush="#8a9a5b"
                    Cursor="Hand" FontSize="12" Click="ReadyBtn_Click"/>
            <Button x:Name="RefreshBtn" Content="Re-capture" Width="100" Height="32" Margin="8,0,0,0"
                    Background="#3a3a3a" Foreground="White" BorderBrush="#555"
                    Cursor="Hand" FontSize="12" Visibility="Collapsed" Click="RefreshBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
