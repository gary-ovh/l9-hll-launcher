<Window x:Class="L9HLL.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[L9] The Loyal Nine - Hell Let Loose Launcher"
        Height="560" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Closing="OnWindowClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="8" PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="8" BlurRadius="20" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Background image -->
            <Image Source="pack://application:,,,/L9HLL.Launcher;component/assets/background.jpg"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

            <!-- Dark overlay -->
            <Rectangle Fill="#000000" Opacity="0.7"/>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,0">
                <Button x:Name="MinimizeBtn" Content="_" Width="32" Height="24" FontSize="14"
                        Background="Transparent" Foreground="#aaa" BorderBrush="Transparent"
                        Cursor="Hand" Click="MinimizeBtn_Click" Margin="0,0,2,0"/>
                <Button x:Name="CloseBtn" Content="X" Width="32" Height="24" FontSize="12"
                        Background="Transparent" Foreground="#aaa" BorderBrush="Transparent"
                        Cursor="Hand" Click="CloseBtn_Click" Margin="2,0,0,0"/>
            </StackPanel>

            <!-- Auto-launch button -->
            <Button Content="{Binding AutoLaunchButtonText}" Width="160" Height="28"
                    HorizontalAlignment="Left" Margin="8,8,0,0"
                    Background="#2a2a2a" Foreground="#8a9a5b" BorderBrush="#444"
                    FontSize="11" Cursor="Hand"
                    Command="{Binding ToggleAutoLaunchCommand}"/>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,44,24,12">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/L9HLL.Launcher;component/assets/l9_logo_small.png"
                           Width="100" Height="96"
                           Stretch="Uniform"
                           Margin="0,0,0,6"/>
                    <TextBlock Text="HELL LET LOOSE"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#8a9a5b"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="[L9] THE LOYAL NINE"
                               FontSize="11" FontWeight="Normal"
                               Foreground="#777"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="Game:" FontSize="12" Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GameSelector"
                                  SelectedValue="{Binding SelectedGame}"
                                  ItemsSource="{Binding GameOptions}"
                                  Width="160"
                                  Style="{StaticResource GameCombo}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ServerCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="10" Height="10" Grid.Column="0"
                                                Background="{Binding IsOnline, Converter={StaticResource BoolToColor}}"
                                                CornerRadius="5"
                                                Margin="12,0,0,0" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#e0e0e0"/>
                                            <TextBlock FontSize="10" Foreground="#888" Margin="0,3,0,0">
                                                <Run Text="Map: "/>
                                                <Run Text="{Binding Map}" Foreground="#aaa"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#888">
                                                <Run Text="Players: "/>
                                                <Run Text="{Binding PlayerCount}" Foreground="#aaa"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding MaxPlayers}" Foreground="#aaa"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="JOIN"
                                                Style="{StaticResource JoinButton}"
                                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Status bar -->
            <TextBlock Text="{Binding StatusText}"
                       FontSize="10"
                       Foreground="#555"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8"/>
        </Grid>
    </Border>
</Window>