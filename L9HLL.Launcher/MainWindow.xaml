<Window x:Class="L9HLL.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="[L9] The Loyal Nine - Hell Let Loose Launcher"
        Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a1a">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/L9HLL.Launcher;component/Assets/L9_Logo_small.png"
                   Width="120" Height="115"
                   Stretch="Uniform"
                   Margin="0,0,0,8"/>
            <TextBlock Text="HELL LET LOOSE"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#8a9a5b"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>
            <TextBlock Text="[L9] THE LOYAL NINE"
                       FontSize="11" FontWeight="Normal"
                       Foreground="#777"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Servers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ServerCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="12" Height="12" Grid.Column="0"
                                    Background="{Binding IsOnline, Converter={StaticResource BoolToColor}}"
                                    CornerRadius="6"
                                    Margin="16,0,0,0" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#e0e0e0"/>
                                <TextBlock FontSize="11" Foreground="#888" Margin="0,4,0,0">
                                    <Run Text="Map: "/>
                                    <Run Text="{Binding Map}" Foreground="#aaa"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#888">
                                    <Run Text="Players: "/>
                                    <Run Text="{Binding PlayerCount}" Foreground="#aaa"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding MaxPlayers}" Foreground="#aaa"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="JOIN"
                                    Style="{StaticResource JoinButton}"
                                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="10"
                   Foreground="#555"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>